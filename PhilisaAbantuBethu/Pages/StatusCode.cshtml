@page
@model StatusCodeModel
@{
    var s = HttpContext.Strings();
    var tooMany = Model.Code == 429;
    var notFound = Model.Code == 404;

    var title = tooMany
        ? s["StatusCode.PleaseWaitFewMinutes"]
        : notFound
            ? s["StatusCode.CantFindPage"]
            : s["StatusCode.SomethingWentWrong"];

    var body = tooMany
        ? s["StatusCode.SeveralMessagesWereSent"]
        : notFound
            ? s["StatusCode.PageMayHaveMoved"]
            : s["StatusCode.PleaseTryAgainCall"];

    ViewData["Title"] = title;
}

<div class="min-h-[60vh] bg-cream flex items-center">
    <div class="max-w-xl mx-auto px-4 py-16 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-ink-900 mb-4 font-serif">@title</h1>
        <p class="text-ink-700 leading-relaxed mb-8">@body</p>

        <div class="bg-white border border-ink-200 rounded-2xl p-6 text-left space-y-2 text-sm">
            <p><span class="font-semibold text-ink-900">@s["Offline.Office"]:</span> <a href="tel:+27215650668" class="text-brand-700 font-semibold">+27 (0)21 565 0668</a></p>
            <p><span class="font-semibold text-ink-900">@s["Offline.CrisisLine"]:</span> <a href="tel:+27817469889" class="text-brand-700 font-semibold">+27 (0)81 746 9889</a></p>
            <p><span class="font-semibold text-ink-900">@s["StatusCode.ImmediateDanger"]:</span> <a href="tel:10111" class="text-brand-700 font-semibold">10111</a></p>
        </div>

        <a href="/" class="inline-flex items-center justify-center mt-8 min-h-[44px] bg-brand-700 hover:bg-brand-800 text-white font-semibold px-6 py-3 rounded-full">
            @s["StatusCode.GoHomePage"]
        </a>
    </div>
</div>
