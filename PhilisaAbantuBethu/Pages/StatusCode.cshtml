@page
@model StatusCodeModel
@{
    var s = HttpContext.Strings();
    var tooMany = Model.Code == 429;
    var notFound = Model.Code == 404;

    var title = tooMany
        ? s.Pick("Please wait a few minutes", "Nceda ulinde imizuzu embalwa", "Wag asseblief 'n paar minute")
        : notFound
            ? s.Pick("We can't find that page", "Asilifumani elo phepha", "Ons kan nie daardie bladsy vind nie")
            : s.Pick("Something went wrong", "Kukho into engahambanga kakuhle", "Iets het verkeerd geloop");

    var body = tooMany
        ? s.Pick("Several messages were sent from this connection in a short time, so this one wasn't sent. Please try again in about 10 minutes, or call us. We're here to help.",
                 "Imiyalezo emininzi ithunyelwe kolu qhagamshelo ngexesha elifutshane, ngoko lo awuthunyelwanga. Nceda uzame kwakhona emva kwemizuzu eli-10, okanye usifowunele. Silapha ukukunceda.",
                 "Verskeie boodskappe is in 'n kort tyd van hierdie verbinding gestuur, so hierdie een is nie gestuur nie. Probeer asseblief oor sowat 10 minute weer, of skakel ons. Ons is hier om te help.")
        : notFound
            ? s.Pick("The page may have moved. You can still ask for help or find our contact details below.",
                     "Iphepha lisenokuba lishukunyisiwe. Usenokucela uncedo okanye ufumane iinkcukacha zethu ngezantsi.",
                     "Die bladsy het dalk geskuif. Jy kan steeds hulp vra of ons kontakbesonderhede hieronder vind.")
            : s.Pick("Please try again, or call us.", "Nceda uzame kwakhona, okanye usifowunele.", "Probeer asseblief weer, of skakel ons.");

    ViewData["Title"] = title;
}

<div class="min-h-[60vh] bg-cream flex items-center">
    <div class="max-w-xl mx-auto px-4 py-16 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-ink-900 mb-4 font-serif">@title</h1>
        <p class="text-ink-700 leading-relaxed mb-8">@body</p>

        <div class="bg-white border border-ink-200 rounded-2xl p-6 text-left space-y-2 text-sm">
            <p><span class="font-semibold text-ink-900">@s.Pick("Office", "Ihhovisi", "Kantoor"):</span> <a href="tel:+27215650668" class="text-brand-700 font-semibold">+27 (0)21 565 0668</a></p>
            <p><span class="font-semibold text-ink-900">@s.Pick("Crisis line", "Umgca wongxamiseko", "Krisislyn"):</span> <a href="tel:+27817469889" class="text-brand-700 font-semibold">+27 (0)81 746 9889</a></p>
            <p><span class="font-semibold text-ink-900">@s.Pick("In immediate danger", "Ukuba usengozini ngoku", "In onmiddellike gevaar"):</span> <a href="tel:10111" class="text-brand-700 font-semibold">10111</a></p>
        </div>

        <a href="/" class="inline-flex items-center justify-center mt-8 min-h-[44px] bg-brand-700 hover:bg-brand-800 text-white font-semibold px-6 py-3 rounded-full">
            @s.Pick("Go to the home page", "Yiya kwikhaya", "Gaan na die tuisblad")
        </a>
    </div>
</div>
