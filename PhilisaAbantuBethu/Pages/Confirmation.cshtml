@page
@{
    var s = HttpContext.Strings();
    var c = s.Confirmation;
    ViewData["Title"] = c.Title;

    var reference = Request.Query["reference"].ToString();
    if (string.IsNullOrWhiteSpace(reference)) { reference = "PAB000"; }

    var today = DateTime.Now.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("en-ZA"));

    var keepRefNote = s.IsEnglish
        ? $"Please save your reference number {reference} in case you need to follow up with us."
        : $"Gcina inombolo yakho yesalathiso ethi {reference} ukuba ufuna ukulandela.";
}

<div class="min-h-[80vh] bg-[#fffbf5] flex items-center">
    <div class="max-w-2xl mx-auto px-4 py-16 text-center w-full">

        <div class="w-24 h-24 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-8">
            <svg width="48" height="48" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="#22c55e" stroke-width="1.5"/>
                <path d="M7 12.5l3.5 3.5 6-7" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <p class="text-green-600 text-sm font-semibold uppercase tracking-widest mb-3">
            @s.Pick("Successfully Submitted", "Ithunyiwe Ngempumelelo")
        </p>
        <h1 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4 leading-snug" style="font-family: Lora, serif;">@c.Title</h1>
        <p class="text-stone-500 text-base leading-relaxed mb-10 max-w-md mx-auto">@c.Sub</p>

        <!-- Reference card -->
        <div class="bg-white border border-stone-100 rounded-2xl p-7 shadow-sm mb-8">
            <dl class="grid grid-cols-3 gap-5 text-center">
                <div>
                    <dt class="text-xs font-semibold text-stone-400 uppercase tracking-widest mb-2">@c.RefLabel</dt>
                    <dd class="font-bold text-stone-900 text-xl font-mono tracking-wide">@reference</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-stone-400 uppercase tracking-widest mb-2">@c.DateLabel</dt>
                    <dd class="font-semibold text-stone-800 text-sm">@today</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold text-stone-400 uppercase tracking-widest mb-2">@c.StatusLabel</dt>
                    <dd><span class="bg-green-100 text-green-800 text-xs font-semibold px-3 py-1 rounded-full">@c.Status</span></dd>
                </div>
            </dl>
            <p class="mt-6 pt-5 border-t border-stone-100 text-xs text-stone-400 text-center leading-relaxed">
                @keepRefNote
            </p>
        </div>

        <!-- What happens next -->
        <div class="bg-purple-50 border border-purple-100 rounded-2xl p-6 text-left mb-8">
            <h2 class="font-bold text-purple-900 mb-4" style="font-family: Lora, serif;">@c.WhatNext</h2>
            <ol class="space-y-3">
                @for (var i = 0; i < c.Steps.Length; i++)
                {
                    <li class="flex items-start gap-3 text-sm text-purple-800">
                        <span class="flex-shrink-0 w-5 h-5 rounded-full bg-purple-200 flex items-center justify-center text-xs font-bold text-purple-900 mt-0.5" aria-hidden="true">@(i + 1)</span>
                        <span>@c.Steps[i]</span>
                    </li>
                }
            </ol>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/" class="bg-purple-700 hover:bg-purple-800 text-white font-semibold px-8 py-3.5 rounded-full transition-colors">@c.BackHome</a>
            <a href="/RequestSupport" class="border border-stone-200 text-stone-700 hover:bg-stone-50 font-semibold px-8 py-3.5 rounded-full transition-colors">@c.AnotherRequest</a>
        </div>
    </div>
</div>
