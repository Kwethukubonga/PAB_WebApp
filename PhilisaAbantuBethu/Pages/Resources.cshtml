<section class="py-20 bg-purple-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
        <p class="text-purple-300 text-sm font-semibold uppercase tracking-widest mb-3">@s.Pick("Helpful Information", "Ulwazi Olwexesha", "Nuttige Inligting")</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-5" style="font-family: Lora, serif;">@s.Nav.Resources</h1>
        <p class="text-purple-100 text-lg max-w-xl mx-auto leading-relaxed">
            @s.Pick("Essential contacts, services, and information to support you and your family.",
                    "Amanxibelelanisi abalulekileyo, iinkonzo, kunye nolwazi ukukuxhasa wena nosapho lwakho.",
                    "Noodsaaklike kontakte, dienste, en inligting om jou en jou gesin te ondersteun.")
        </p>
    </div>
</section>

<section class="py-20 bg-[#fffbf5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
            @foreach (var res in resources)
            {
                <div class="bg-white rounded-2xl p-7 border border-stone-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3 mb-5">
                        <span class="text-2xl" aria-hidden="true">@res.Icon</span>
                        <h2 class="font-bold text-stone-900 text-lg" style="font-family: Lora, serif;">@s.Pick(res.Category, res.CategoryXh, res.CategoryAf)</h2>
                    </div>
                    <ul class="space-y-3">
                        @foreach (var item in (s.Lang switch { "xh" => res.ItemsXh, "af" => res.ItemsAf, _ => res.Items }))
                        {
                            <li class="text-sm text-stone-600 flex items-start gap-2 leading-relaxed">
                                <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color: @res.Color;" aria-hidden="true"></span>
                                <span>@item</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- FAQ -->
        <div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
            <div class="px-7 py-6 border-b border-stone-100 flex items-center gap-3">
                <span class="text-2xl" aria-hidden="true">❓</span>
                <h2 class="font-bold text-stone-900 text-xl" style="font-family: Lora, serif;">
                    @s.Pick("Frequently Asked Questions", "Imibuzo Ebuzwa Rhoqo", "Gereelde Vrae")
                </h2>
            </div>
            <div>
                @for (var i = 0; i < faqs.Length; i++)
                {
                    var (question, answer) = faqs[i];
                    <div class="border-b border-stone-100 last:border-0">
                        <h3>
                            <button type="button" data-faq-toggle
                                    aria-expanded="false" aria-controls="faq-panel-@i"
                                    class="w-full flex items-center justify-between px-7 py-5 text-left hover:bg-stone-50 transition-colors">
                                <span class="font-medium text-stone-800">@question</span>
                                <svg data-faq-icon width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                                     class="flex-shrink-0 ml-4 transition-transform" aria-hidden="true">
                                    <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </h3>
                        <div id="faq-panel-@i" hidden class="px-7 pb-5 text-stone-500 text-sm leading-relaxed">@answer</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-16 bg-amber-50 border-t border-amber-100 text-center">
    <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-stone-900 mb-3" style="font-family: Lora, serif;">@s.Pick("Need More Help?", "Ufuna Uncedo Oluninzi?", "Benodig Jy Meer Hulp?")</h2>
        <p class="text-stone-600 mb-6 text-sm">
            @s.Pick("Get in touch and our team will be in touch within 2–5 business days.",
                    "Qhagamshelana nathi kwaye iqela lethu liza kuqhagamshelana nawe phakathi kweentsuku ezi-2–5 zomsebenzi.",
                    "Kontak ons en ons span sal binne 2–5 besigheidsdae met jou skakel.")
        </p>
        <a href="/Contact" class="inline-block bg-purple-700 hover:bg-purple-800 text-white font-semibold px-8 py-3.5 rounded-full transition-colors">
            @s.Home.ContactUs
        </a>
    </div>
</section>