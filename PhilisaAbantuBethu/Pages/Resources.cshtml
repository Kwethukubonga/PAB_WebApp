@page
@using PhilisaAbantuBethu.Data
@{
    var s = HttpContext.Strings();
    var lang = HttpContext.CurrentLang();
    ViewData["Title"] = s.Nav.Resources;
}

@* The eyebrow label above the heading is gone: it said nothing the heading didn't (E4). *@
<section class="py-20 bg-brand-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold mb-5 font-serif">@s.Nav.Resources</h1>
        <p class="text-on-brand-muted text-lg max-w-xl mx-auto leading-relaxed">
            @s.Pick("Essential contacts, services, and information to support you and your family.",
                    "Amanxibelelanisi abalulekileyo, iinkonzo, kunye nolwazi ukukuxhasa wena nosapho lwakho.",
                    "Noodsaaklike kontakte, dienste, en inligting om jou en jou gesin te ondersteun.")
        </p>
        <p class="mt-5 text-sm text-on-brand-muted" data-offline-ready hidden>
            @s.Pick("These numbers stay on this page even with no data.",
                    "La manani ahlala kweli phepha nangaphandle kwedatha.",
                    "Hierdie nommers bly op hierdie bladsy, selfs sonder data.")
        </p>
    </div>
</section>

<section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
            @foreach (var category in ResourceData.Categories)
            {
                <div class="card p-7 hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3 mb-5">
                        @* One stroke-icon family across the whole site, in place of the emoji
                           that stood in for icons on six pages (E5). *@
                        <span class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
                              style="background-color: @(category.Colour)1A; color: @category.Colour;">
                            <partial name="_Icon" model="@category.Icon" />
                        </span>
                        <h2 class="font-bold text-ink-900 text-lg font-serif">@category.Name.For(lang)</h2>
                    </div>
                    <ul class="space-y-3">
                        @foreach (var item in category.Items)
                        {
                            <li class="text-sm text-ink-600 flex items-start gap-2 leading-relaxed">
                                <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0"
                                      style="background-color: @category.Colour;" aria-hidden="true"></span>
                                <span>@item.For(lang)</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- FAQ -->
        <div class="card overflow-hidden">
            <div class="px-7 py-6 border-b border-ink-100 flex items-center gap-3">
                <span class="text-brand-700 flex-shrink-0">
                    <partial name="_Icon" model="@("help")" />
                </span>
                <h2 class="font-bold text-ink-900 text-xl font-serif">
                    @s.Pick("Frequently Asked Questions", "Imibuzo Ebuzwa Rhoqo", "Gereelde Vrae")
                </h2>
            </div>
            <div>
                @for (var i = 0; i < ResourceData.Questions.Count; i++)
                {
                    var question = ResourceData.Questions[i];
                    var isLast = i == ResourceData.Questions.Count - 1;
                    <div class="border-b border-ink-100 last:border-0">
                        <h3>
                            <button type="button" data-faq-toggle
                                    aria-expanded="false" aria-controls="faq-panel-@i"
                                    class="w-full flex items-center justify-between gap-4 min-h-target px-7 py-5 text-left hover:bg-ink-50 transition-colors">
                                <span class="font-medium text-ink-900">@question.Question.For(lang)</span>
                                <svg data-faq-icon width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                                     class="flex-shrink-0 transition-transform text-ink-600" aria-hidden="true">
                                    <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </h3>
                        <div id="faq-panel-@i" hidden class="px-7 pb-5 text-ink-600 text-sm leading-relaxed">
                            <p>@question.Answer.For(lang)</p>

                            @* The last question is the one about clearing this site off the phone,
                               so the button that does it belongs with the answer (G4, W11). *@
                            @if (isLast)
                            {
                                <button type="button" data-forget-site hidden class="btn-secondary mt-4 text-sm">
                                    @s.Pick("Clear what this site has saved on this phone",
                                            "Susa oko le sayithi iyigcinileyo kule fowuni",
                                            "Vee uit wat hierdie werf op hierdie foon gestoor het")
                                </button>
                                <p data-forget-done hidden role="status" class="mt-3 text-sm font-medium text-status-success">
                                    @s.Pick("Cleared. The emergency numbers will need data again.",
                                            "Kususwe. Amanani ongxamiseko aza kufuna idatha kwakhona.",
                                            "Uitgevee. Die noodnommers sal weer data nodig hê.")
                                </p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-16 bg-amber-50 border-t border-amber-100 text-center">
    <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-ink-900 mb-3 font-serif">@s.Pick("Need More Help?", "Ufuna Uncedo Oluninzi?", "Benodig Jy Meer Hulp?")</h2>
        <p class="text-ink-600 mb-6 text-sm">
            @s.Pick("Get in touch and our team will be in touch within 2–5 business days.",
                    "Qhagamshelana nathi kwaye iqela lethu liza kuqhagamshelana nawe phakathi kweentsuku ezi-2–5 zomsebenzi.",
                    "Kontak ons en ons span sal binne 2–5 besigheidsdae met jou skakel.")
        </p>
        <a href="/Contact" class="btn-primary">
            @s.Home.ContactUs
        </a>
    </div>
</section>
