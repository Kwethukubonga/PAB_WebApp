@page
@model PrivacyModel
@{
    // Every word comes from the language files, like the other public pages: this is the page
    // where understanding how information is used matters most (FR09, POPIA, #26).
    var s = HttpContext.Strings();
    ViewData["Title"] = s["Privacy.Title"];
}

<!-- Page hero -->
<section class="relative py-20 bg-brand-900 overflow-hidden">
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
        <p class="text-on-brand-muted text-sm font-semibold uppercase tracking-widest mb-3">@s["Privacy.Eyebrow"]</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-5 font-serif">@ViewData["Title"]</h1>
        <p class="text-on-brand-muted text-lg max-w-2xl mx-auto leading-relaxed">
            @s["Privacy.Intro"]
        </p>
    </div>
</section>

<section class="py-16 bg-cream">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

        <div>
            <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Privacy.WhyTitle"]</h2>
            <p class="text-ink-600 leading-relaxed">
                @s["Privacy.WhyBody"]
            </p>
        </div>

        <div>
            <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Privacy.CollectTitle"]</h2>
            <p class="text-ink-600 leading-relaxed mb-4">
                @s["Privacy.CollectIntro"]
            </p>
            <ul class="space-y-3 text-ink-600">
                <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-100 flex items-center justify-center mt-0.5" aria-hidden="true">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-700"></span>
                    </span>
                    <span><strong class="text-ink-900">@s["Privacy.CollectSupportLabel"]</strong> @s["Privacy.CollectSupport"]</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-100 flex items-center justify-center mt-0.5" aria-hidden="true">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-700"></span>
                    </span>
                    <span><strong class="text-ink-900">@s["Privacy.CollectContactLabel"]</strong> @s["Privacy.CollectContact"]</span>
                </li>
            </ul>
            <p class="text-ink-600 leading-relaxed mt-4">
                @s["Privacy.NoAccount"]
            </p>
        </div>

        <div>
            <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Privacy.UseTitle"]</h2>
            <p class="text-ink-600 leading-relaxed">
                @s["Privacy.UseBody"]
            </p>
        </div>

        <div>
            <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Privacy.ProtectTitle"]</h2>
            <p class="text-ink-600 leading-relaxed">
                @s["Privacy.ProtectBody"]
            </p>
        </div>

        <div>
            <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Privacy.RightsTitle"]</h2>
            <p class="text-ink-600 leading-relaxed">
                @s["Privacy.RightsBody"]
                <a href="mailto:admin@philisaabafazi.org" class="text-brand-700 font-semibold hover:text-brand-900">admin@philisaabafazi.org</a>
                @s["Privacy.RightsAfter"]
            </p>
        </div>

    </div>
</section>

<!-- CTA -->
<section class="py-16 bg-amber-50 border-t border-amber-100 text-center">
    <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Privacy.QuestionsTitle"]</h2>
        <p class="text-ink-600 mb-6 text-sm">@s["Privacy.QuestionsBody"]</p>
        <a href="/Contact" class="inline-block bg-brand-700 hover:bg-brand-800 text-white font-semibold px-8 py-3.5 rounded-full transition-colors">@s["Contact.ContactUs"]</a>
    </div>
</section>
