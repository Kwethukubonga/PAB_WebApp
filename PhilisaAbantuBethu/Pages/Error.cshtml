@page
@model ErrorModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<section class="min-h-[70vh] bg-cream flex items-center">
    <div class="max-w-2xl mx-auto px-4 py-16 text-center w-full">
        <div class="w-20 h-20 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-8" aria-hidden="true">
            <svg width="36" height="36" fill="none" viewBox="0 0 24 24">
                <path d="M12 9v4m0 4h.01M10.29 3.86l-8.18 14.18A2 2 0 004 21h16a2 2 0 001.89-2.96L13.71 3.86a2 2 0 00-3.42 0z"
                      stroke="#DC2626" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <p class="text-red-600 text-sm font-semibold uppercase tracking-widest mb-3">Something Went Wrong</p>
        <h1 class="text-2xl md:text-3xl font-bold text-ink-900 mb-4 font-serif">
            We're sorry, an error occurred
        </h1>
        <p class="text-ink-500 text-base leading-relaxed mb-8 max-w-md mx-auto">
            This wasn't your fault. Please try again, and if the problem continues, reach out to us directly so we
            can help.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="bg-white border border-ink-100 rounded-2xl p-5 shadow-sm mb-8 inline-block">
                <p class="text-xs font-semibold text-ink-500 uppercase tracking-widest mb-1">Reference for our team</p>
                <p class="font-mono text-sm text-ink-700">@Model.RequestId</p>
            </div>
        }

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/" class="bg-brand-700 hover:bg-brand-800 text-white font-semibold px-8 py-3.5 rounded-full transition-colors">Back to Home</a>
            <a href="/Contact" class="border border-ink-200 text-ink-700 hover:bg-ink-50 font-semibold px-8 py-3.5 rounded-full transition-colors">Contact Us</a>
        </div>
    </div>
</section>
