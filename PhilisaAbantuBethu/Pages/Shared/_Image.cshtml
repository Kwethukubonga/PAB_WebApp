@using PhilisaAbantuBethu.Data
@model SitePhoto
@*
    One photo, served the cheapest way it can be (H2).

    None of the photos used to lazy-load, none said how big they were, and all of them were
    full-size JPEGs: 7.3MB in all, with a 1200px portrait behind an 80px avatar. Data costs PAB's
    community real money, so each one now comes as WebP at a width the browser picks for the
    space it is shown in, with the JPEG still there for a browser that cannot read WebP.

    width and height are the photo's own, which lets the browser reserve the right space before
    it arrives, so the page does not jump as the photos load.

    Anything above the first screen (Eager) is fetched straight away; everything else waits until
    it is nearly in view.
*@
@{
    var photo = Model;
    var info = SiteImages.For(photo.Src);
}
@if (info is { } image)
{
    <picture>
        <source type="image/webp" srcset="@image.SrcSet" sizes="@photo.Sizes" />
        <img src="@photo.Src"
             alt="@photo.Alt"
             width="@image.Width"
             height="@image.Height"
             loading="@(photo.Eager ? "eager" : "lazy")"
             fetchpriority="@(photo.Eager ? "high" : "auto")"
             decoding="async"
             aria-hidden="@(photo.Decorative ? "true" : null)"
             style="@photo.Style"
             class="@photo.Class" />
    </picture>
}
else
{
    @* A photo added since `npm run images` last ran. Still shown, just not optimised. *@
    <img src="@photo.Src"
         alt="@photo.Alt"
         loading="@(photo.Eager ? "eager" : "lazy")"
         decoding="async"
         aria-hidden="@(photo.Decorative ? "true" : null)"
         style="@photo.Style"
         class="@photo.Class" />
}
