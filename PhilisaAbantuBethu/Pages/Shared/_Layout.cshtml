@{
    var s = Context.Strings();
    var lang = Context.CurrentLang();
    var otherLang = lang == "en" ? "xh" : "en";
    var htmlLang = lang == "xh" ? "xh-ZA" : "en-ZA";
    var openMenuLabel = s.Pick("Open menu", "Vula imenyu");
    var skipLabel = s.Pick("Skip to content", "Tsibela kumxholo");
    var aboutLabel = s.Pick("About Us", "Ngathi");
    var toggleUrl = Context.LangToggleUrl();
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Philisa Abantu Bethu</title>
    <meta name="description" content="Philisa Abantu Bethu — free, confidential community support in Cape Town. Powered by Philisa Abafazi Bethu Women Centre SA." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@@0,400;0,600;0,700;1,400&family=Inter:wght@@400;500;600;700&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        serif: ['Lora', 'Georgia', 'serif']
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="font-sans antialiased text-stone-900 bg-white">

<a class="skip-link" href="#content">@skipLabel</a>

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-stone-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-[68px]">

            <a href="/" class="flex items-center gap-2.5">
                <span class="w-9 h-9 rounded-full bg-purple-800 flex items-center justify-center flex-shrink-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2C8.5 2 5.5 4.5 5.5 8c0 2.5 1.5 4.7 3.5 5.7V15h6v-1.3c2-1 3.5-3.2 3.5-5.7C18.5 4.5 15.5 2 12 2z" fill="white" opacity="0.9"/>
                        <path d="M9 15v2c0 1.7 1.3 3 3 3s3-1.3 3-3v-2H9z" fill="white" opacity="0.7"/>
                    </svg>
                </span>
                <span class="leading-tight">
                    <span class="block text-stone-900 font-semibold text-sm" style="font-family: Lora, serif;">Philisa Abafazi Bethu</span>
                    <span class="block text-stone-400 text-xs">Women Centre SA</span>
                </span>
            </a>

            <nav class="hidden lg:flex items-center gap-7" aria-label="@s.Pick("Main", "Ephambili")">
                <a href="/" class="text-sm font-medium text-stone-600 hover:text-purple-700 transition-colors">@s.Nav.Home</a>
                <a href="/About" class="text-sm font-medium text-stone-600 hover:text-purple-700 transition-colors">@aboutLabel</a>
                <a href="/Programmes" class="text-sm font-medium text-stone-600 hover:text-purple-700 transition-colors">@s.Nav.Programmes</a>
                <a href="/Resources" class="text-sm font-medium text-stone-600 hover:text-purple-700 transition-colors">@s.Nav.Resources</a>
                <a href="/Contact" class="text-sm font-medium text-stone-600 hover:text-purple-700 transition-colors">@s.Nav.Contact</a>
            </nav>

            <div class="hidden lg:flex items-center gap-4">
                <a href="@toggleUrl" lang="@otherLang"
                   class="text-sm font-medium text-stone-500 hover:text-purple-700 transition-colors border border-stone-200 rounded-full px-3 py-1.5">
                    @s.Nav.LangToggle
                </a>
                <a href="/RequestSupport" class="bg-purple-700 hover:bg-purple-800 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors">
                    @s.Nav.RequestSupport
                </a>
            </div>

            <button type="button" data-nav-toggle
                    class="lg:hidden w-10 h-10 -mr-2 flex items-center justify-center text-stone-700 rounded-lg hover:bg-stone-100 transition-colors"
                    aria-controls="mobile-nav" aria-expanded="false" aria-label="@openMenuLabel">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-nav" hidden class="lg:hidden border-t border-stone-100 bg-white">
        <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1" aria-label="@s.Pick("Mobile", "Kwifowuni")">
            <a href="/" class="px-3 py-2.5 rounded-lg text-sm font-medium text-stone-700 hover:bg-stone-50">@s.Nav.Home</a>
            <a href="/About" class="px-3 py-2.5 rounded-lg text-sm font-medium text-stone-700 hover:bg-stone-50">@aboutLabel</a>
            <a href="/Programmes" class="px-3 py-2.5 rounded-lg text-sm font-medium text-stone-700 hover:bg-stone-50">@s.Nav.Programmes</a>
            <a href="/Resources" class="px-3 py-2.5 rounded-lg text-sm font-medium text-stone-700 hover:bg-stone-50">@s.Nav.Resources</a>
            <a href="/Contact" class="px-3 py-2.5 rounded-lg text-sm font-medium text-stone-700 hover:bg-stone-50">@s.Nav.Contact</a>
            <a href="@toggleUrl" lang="@otherLang" class="px-3 py-2.5 rounded-lg text-sm font-medium text-stone-500 hover:bg-stone-50">@s.Nav.LangToggle</a>
            <a href="/RequestSupport" class="mt-2 bg-purple-700 text-white text-sm font-semibold px-5 py-3 rounded-full text-center">@s.Nav.RequestSupport</a>
        </nav>
    </div>
</header>

<main id="content">
    @RenderBody()
</main>

<footer class="bg-purple-950 text-purple-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="md:col-span-2">
                <div class="flex items-center gap-2.5 mb-4">
                    <span class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 2C8.5 2 5.5 4.5 5.5 8c0 2.5 1.5 4.7 3.5 5.7V15h6v-1.3c2-1 3.5-3.2 3.5-5.7C18.5 4.5 15.5 2 12 2z" fill="white" opacity="0.9"/>
                            <path d="M9 15v2c0 1.7 1.3 3 3 3s3-1.3 3-3v-2H9z" fill="white" opacity="0.7"/>
                        </svg>
                    </span>
                    <span class="text-white font-semibold" style="font-family: Lora, serif;">Philisa Abafazi Bethu</span>
                </div>
                <p class="text-sm leading-relaxed max-w-md">@s.Home.ServiceNote</p>
                <p class="text-purple-400 text-xs mt-5">@s.Pick("Lavender Hill, Cape Town, Western Cape", "Lavender Hill, eKapa, Ntshona Koloni")</p>
            </div>

            <div>
                <h2 class="text-white font-semibold text-sm mb-4" style="font-family: Lora, serif;">@s.Pick("Explore", "Jonga")</h2>
                <ul class="space-y-2.5 text-sm">
                    <li><a href="/About" class="hover:text-white transition-colors">@aboutLabel</a></li>
                    <li><a href="/Programmes" class="hover:text-white transition-colors">@s.Nav.Programmes</a></li>
                    <li><a href="/Resources" class="hover:text-white transition-colors">@s.Nav.Resources</a></li>
                    <li><a href="/Contact" class="hover:text-white transition-colors">@s.Nav.Contact</a></li>
                </ul>
            </div>

            <div>
                <h2 class="text-white font-semibold text-sm mb-4" style="font-family: Lora, serif;">@s.Pick("Get help now", "Fumana uncedo ngoku")</h2>
                <ul class="space-y-2.5 text-sm">
                    <li>@s.Pick("Office", "Ihhovisi"): <a href="tel:+27210000000" class="hover:text-white">+27 21 000 0000</a></li>
                    <li>@s.Pick("Crisis line", "Umgca wongxamiseko"): <a href="tel:+27210000001" class="text-amber-300 font-semibold hover:text-amber-200">+27 21 000 0001</a></li>
                    <li>@s.Pick("Email", "I-imeyili"): <a href="mailto:info@@philisaabafazi.org.za" class="hover:text-white">info@@philisaabafazi.org.za</a></li>
                    <li class="pt-2 text-purple-400 text-xs">@s.Pick("GBV helpline", "Umgca woncedo we-GBV"): 0800 428 428 (24/7)</li>
                </ul>
            </div>
        </div>

        <div class="mt-12 pt-6 border-t border-purple-900 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-purple-400">
            <p>&copy; @DateTime.Now.Year Philisa Abafazi Bethu Women Centre SA. NPO 123-456.</p>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
