@{
    var s = Context.Strings();
    var lang = Context.CurrentLang();
    var htmlLang = lang switch { "xh" => "xh-ZA", "af" => "af-ZA", _ => "en-ZA" };
    var openMenuLabel = s["Layout.OpenMenu"];
    var skipLabel = s["Layout.SkipContent"];
    var aboutLabel = s["Layout.AboutUs"];
    // Staff pages don't need it, and their own sign-out should be the way out there.
    var showQuickExit = ViewData["HideQuickExit"] as bool? != true;
    var quickExitLabel = s["Layout.LeaveSite"];
    var quickExitHint = s["Layout.LeavesStraightAwayWeather"];
    var langOptions = new[]
    {
        ("en", "English"),
        ("xh", "isiXhosa"),
        ("af", "Afrikaans")
    };
    var socialLinks = new[]
    {
        ("Instagram", "https://www.instagram.com/philisaabafazibethu/"),
        ("YouTube", "https://www.youtube.com/@philisaabafazi"),
        ("Facebook", "https://www.facebook.com/PhilisaAbafazi")
    };
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Philisa Abafazi Bethu</title>
    <meta name="description" content="Philisa Abafazi Bethu: free, confidential community support in Cape Town. Powered by Philisa Abafazi Bethu Women Centre SA." />
    @if (ViewData["NoIndex"] as bool? == true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" href="~/img/brand/logo.png" />
    <link rel="apple-touch-icon" href="~/img/brand/logo.png" />

    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#3B0764" />

    @* Served from this site rather than Google: faster on expensive data, and the pages someone
       reads here are the fact that they are looking for help (H3, POPIA). Plain paths, not ~/:
       the stylesheet asks for these by the same name, and a fingerprinted preload would be a
       second URL for the same file, so each font came down twice. *@
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin />

    @* One built stylesheet with only the classes the pages use, in place of the Tailwind CDN,
       which compiled the whole framework in the visitor's browser on every page load (H1). *@
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="font-sans antialiased text-ink-900 bg-white">

<a class="skip-link" href="#content">@skipLabel</a>

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-ink-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-[68px]">

            <a href="/" class="flex items-center gap-2.5">
                <img src="~/img/brand/logo.png" alt="Philisa Abafazi Bethu" width="36" height="36" class="w-9 h-9 rounded-full flex-shrink-0" />
                <span class="leading-tight">
                    <span class="block text-ink-900 font-semibold text-sm font-serif">Philisa Abafazi Bethu</span>
                    @* Was stone-400, which measured 2.5:1 on white. ink-500 is 4.8:1 (F1). *@
                    <span class="block text-ink-500 text-xs">Women Centre SA</span>
                </span>
            </a>

            <nav class="hidden lg:flex items-center gap-7" aria-label="@s["Layout.Main"]">
                <a href="/" class="text-sm font-medium text-ink-600 hover:text-brand-700 transition-colors">@s.Nav.Home</a>
                <a href="/About" class="text-sm font-medium text-ink-600 hover:text-brand-700 transition-colors">@aboutLabel</a>
                <a href="/Programmes" class="text-sm font-medium text-ink-600 hover:text-brand-700 transition-colors">@s.Nav.Programmes</a>
                <a href="/Resources" class="text-sm font-medium text-ink-600 hover:text-brand-700 transition-colors">@s.Nav.Resources</a>
                <a href="/Contact" class="text-sm font-medium text-ink-600 hover:text-brand-700 transition-colors">@s.Nav.Contact</a>
            </nav>

            <div class="hidden lg:flex items-center gap-4">
                @* Switching language is how an isiXhosa or Afrikaans speaker reads the site at
                   all, so these are full-size targets rather than the 28px they were (F5). *@
                <div class="flex items-center border border-ink-200 rounded-full p-0.5 text-sm font-medium" role="group"
                     aria-label="@s["Layout.Language"]">
                    @foreach (var (code, label) in langOptions)
                    {
                        <a href="@Context.LangUrl(code)" lang="@code"
                           aria-current="@(lang == code ? "true" : null)"
                           class="@(lang == code ? "bg-brand-700 text-white" : "text-ink-600 hover:text-brand-700") inline-flex items-center min-h-target px-3.5 rounded-full transition-colors">
                            @label
                        </a>
                    }
                </div>
                <a href="/RequestSupport" class="btn-primary text-sm">
                    @s.Nav.RequestSupport
                </a>
                <div class="flex items-center gap-1">
                    @foreach (var (name, url) in socialLinks)
                    {
                        @* 32px before, which is under the 44px minimum (F5). *@
                        <a href="@url" target="_blank" rel="noopener noreferrer" aria-label="@name"
                           class="w-11 h-11 flex items-center justify-center rounded-full text-ink-500 hover:text-brand-700 hover:bg-ink-50 transition-colors">
                            @if (name == "Instagram")
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                                </svg>
                            }
                            else if (name == "YouTube")
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
                                    <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                                </svg>
                            }
                        </a>
                    }
                </div>
            </div>

            @if (showQuickExit)
            {
                @* On a phone the way out sits here, in the header that stays on screen, so it never
                   covers the page: as a floating button it lay over Home's "Request Support" on a
                   small phone (#27). From sm up the round corner button below is used instead. *@
                <a href="https://www.google.com/search?q=weather+cape+town" data-quick-exit rel="noreferrer"
                   title="@quickExitHint"
                   class="sm:hidden ml-auto mr-1 inline-flex items-center gap-1.5 min-h-[44px] px-3.5 rounded-full bg-ink-900 hover:bg-black text-white text-sm font-semibold">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"/>
                    </svg>
                    @s["Layout.LeaveShort"]
                    <span class="sr-only">. @quickExitHint</span>
                </a>
            }

            <button type="button" data-nav-toggle
                    class="lg:hidden w-11 h-11 -mr-2 flex items-center justify-center text-ink-700 rounded-lg hover:bg-ink-100 transition-colors"
                    aria-controls="mobile-nav" aria-expanded="false" aria-label="@openMenuLabel">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-nav" hidden class="lg:hidden border-t border-ink-100 bg-white">
        <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1" aria-label="@s["Layout.Mobile"]">
            <a href="/" class="flex items-center min-h-target px-3 rounded-lg text-sm font-medium text-ink-700 hover:bg-ink-50">@s.Nav.Home</a>
            <a href="/About" class="flex items-center min-h-target px-3 rounded-lg text-sm font-medium text-ink-700 hover:bg-ink-50">@aboutLabel</a>
            <a href="/Programmes" class="flex items-center min-h-target px-3 rounded-lg text-sm font-medium text-ink-700 hover:bg-ink-50">@s.Nav.Programmes</a>
            <a href="/Resources" class="flex items-center min-h-target px-3 rounded-lg text-sm font-medium text-ink-700 hover:bg-ink-50">@s.Nav.Resources</a>
            <a href="/Contact" class="flex items-center min-h-target px-3 rounded-lg text-sm font-medium text-ink-700 hover:bg-ink-50">@s.Nav.Contact</a>
            <div class="flex items-center gap-2 px-3 py-2.5">
                @foreach (var (code, label) in langOptions)
                {
                    <a href="@Context.LangUrl(code)" lang="@code"
                       aria-current="@(lang == code ? "true" : null)"
                       class="@(lang == code ? "bg-brand-700 text-white" : "bg-ink-100 text-ink-700") inline-flex items-center min-h-target text-xs font-medium px-4 rounded-full transition-colors">
                        @label
                    </a>
                }
            </div>
            <a href="/RequestSupport" class="btn-primary mt-2 w-full text-sm">@s.Nav.RequestSupport</a>
            <div class="flex items-center justify-center gap-2 mt-3">
                @foreach (var (name, url) in socialLinks)
                {
                    <a href="@url" target="_blank" rel="noopener noreferrer" aria-label="@name"
                       class="w-11 h-11 flex items-center justify-center rounded-full bg-ink-100 text-ink-700 hover:text-brand-700 transition-colors">
                        @if (name == "Instagram")
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                            </svg>
                        }
                        else if (name == "YouTube")
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
                                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                            </svg>
                        }
                    </a>
                }
            </div>
        </nav>
    </div>
</header>

<main id="content">
    @RenderBody()
</main>

@if (showQuickExit)
{
    @* From sm up; on a phone the header's "Leave" button takes its place (#27). *@
    <a href="https://www.google.com/search?q=weather+cape+town" data-quick-exit rel="noreferrer"
       title="@quickExitHint"
       class="fixed bottom-4 right-4 z-[60] hidden sm:inline-flex items-center gap-2 min-h-[44px] bg-ink-900 hover:bg-black text-white text-sm font-semibold px-5 py-3 rounded-full shadow-lg">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"/>
        </svg>
        @quickExitLabel
        <span class="sr-only">. @quickExitHint</span>
    </a>
}

<footer class="bg-brand-900 text-brand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="md:col-span-2">
                <div class="flex items-center gap-2.5 mb-4">
                    <img src="~/img/brand/logo.png" alt="Philisa Abafazi Bethu" width="36" height="36" loading="lazy" decoding="async" class="w-9 h-9 rounded-full bg-white/15" />
                    <span class="text-white font-semibold font-serif">Philisa Abafazi Bethu</span>
                </div>
                <p class="text-sm leading-relaxed max-w-md">@s.Home.ServiceNote</p>
                <p class="text-on-brand-muted text-xs mt-5">55 Strauss Road, Steenberg, 7965, @s["Layout.WesternCape"]</p>
            </div>

            <div>
                <h2 class="text-white font-semibold text-sm mb-4 font-serif">@s["Layout.Explore"]</h2>
                <ul class="space-y-2.5 text-sm">
                    <li><a href="/About" class="hover:text-white transition-colors">@aboutLabel</a></li>
                    <li><a href="/Programmes" class="hover:text-white transition-colors">@s.Nav.Programmes</a></li>
                    <li><a href="/Resources" class="hover:text-white transition-colors">@s.Nav.Resources</a></li>
                    <li><a href="/Contact" class="hover:text-white transition-colors">@s.Nav.Contact</a></li>
                </ul>
            </div>

            <div>
                <h2 class="text-white font-semibold text-sm mb-4 font-serif">@s["Layout.GetHelpNow"]</h2>
                <ul class="space-y-2.5 text-sm">
                    <li>@s["Offline.Office"]: <a href="tel:+27215650668" class="hover:text-white">+27 (0)21 565 0668</a></li>
                    <li>@s["Offline.CrisisLine"]: <a href="tel:+27817469889" class="text-amber-300 font-semibold hover:text-amber-200">+27 (0)81 746 9889</a></li>
                    <li>@s["Layout.Email"]: <a href="mailto:admin@@philisaabafazi.org" class="hover:text-white">admin@@philisaabafazi.org</a></li>
                    <li class="pt-2 text-on-brand-muted text-xs">@s["Layout.GBVHelpline"]: 0800 428 428 (24/7)</li>
                </ul>
            </div>
        </div>

        <div class="mt-12 pt-6 border-t border-brand-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-on-brand-muted">
            <p>&copy; @DateTime.Now.Year Philisa Abafazi Bethu Women Centre SA.</p>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
