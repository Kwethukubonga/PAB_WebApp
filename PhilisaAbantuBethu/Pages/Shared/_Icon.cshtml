@model string
@*
    One icon family for the whole site (E5).

    Emoji stood in for icons on six pages, next to the stroke SVGs in the header, so the site had
    two icon styles at once; emoji also draw differently on every phone and some screen readers
    read them out ("handshake", "purple heart") in the middle of a sentence.

    These are drawn inline, in the header's style: 24x24, no fill, 2px stroke, currentColor. Being
    inline means no icon font to download, which matters on expensive data (H1).

    Each one is decorative and sits beside a heading that already says what it is, so they are all
    aria-hidden. Use <partial name="_Icon" model="@("name")" />.
*@
@{
    // 24x24 viewBox, stroked, no fill.
    var paths = Model switch
    {
        // Resources
        "emergency_home" => new[] { "M12 2 2 8v12h20V8L12 2z", "M12 10v5", "M12 18h.01" },
        "diversity_3" => new[] { "M9 7a3 3 0 1 0 0-.01", "M17 11a2.5 2.5 0 1 0 0-.01", "M4 20c0-2.8 2.2-5 5-5s5 2.2 5 5", "M15 20c0-2 1.6-3.5 3.5-3.5S22 18 22 20" },
        "balance" => new[] { "M12 3v18", "M5 7h14", "M5 7 2 14h6L5 7z", "M19 7l-3 7h6l-3-7z", "M8 21h8" },
        "child_care" => new[] { "M12 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12z", "M9 9h.01", "M15 9h.01", "M9.5 12.5a3.5 3.5 0 0 0 5 0", "M12 16v5" },
        "psychology" => new[] { "M14 3a6 6 0 0 0-6 6c0 1.6-1 2.4-1.7 3.2-.5.5-.3 1.3.4 1.5l1.3.4V18a2 2 0 0 0 2 2h2v-3h4a4 4 0 0 0 4-4V9a6 6 0 0 0-6-6z", "M12 7v4" },
        "help" => new[] { "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z", "M9.2 9a2.8 2.8 0 0 1 5.5.8c0 1.9-2.7 2.1-2.7 4", "M12 17h.01" },

        // About and the programmes
        "shield" => new[] { "M12 2.5 4.5 5.5V11c0 4.8 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.7 7.5-9.5V5.5L12 2.5z", "M12 9.5a1.8 1.8 0 1 0 0-.01", "M8.8 15.6a3.6 3.6 0 0 1 6.4 0" },
        "handshake" => new[] { "M11 17 8.5 19.5a2 2 0 0 1-2.8 0l-3.2-3.2a2 2 0 0 1 0-2.8L8 7.9", "M13 7l2.5-2.5a2 2 0 0 1 2.8 0l3.2 3.2a2 2 0 0 1 0 2.8L16 16.1", "M9 12l3 3", "M12 9l3 3" },
        "heart" => new[] { "M12 20.3 4.6 13a4.7 4.7 0 0 1 0-6.7 4.7 4.7 0 0 1 6.6 0l.8.8.8-.8a4.7 4.7 0 0 1 6.6 0 4.7 4.7 0 0 1 0 6.7L12 20.3z" },
        "strength" => new[] { "M7 11V6a2 2 0 1 1 4 0v5", "M11 11V5a2 2 0 1 1 4 0v6", "M15 11V7a2 2 0 1 1 4 0v8a6 6 0 0 1-6 6h-1a7 7 0 0 1-7-7v-3", "M3 11h4" },
        "globe" => new[] { "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z", "M2 12h20", "M12 2a15 15 0 0 1 0 20", "M12 2a15 15 0 0 0 0 20" },
        "clipboard" => new[] { "M9 4h6v3H9V4z", "M9 5.5H7a2 2 0 0 0-2 2V20a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7.5a2 2 0 0 0-2-2h-2", "M9 12h6", "M9 16h4" },
