        // Contact
        "phone" => new[] { "M15.5 21A12.5 12.5 0 0 1 3 8.5V6a2 2 0 0 1 2-2h2.3a1 1 0 0 1 1 .8l.7 3a1 1 0 0 1-.5 1.1l-1.4.7a9.6 9.6 0 0 0 4.4 4.4l.7-1.4a1 1 0 0 1 1.1-.5l3 .7a1 1 0 0 1 .8 1V19a2 2 0 0 1-2 2h-.1z" },
        "mail" => new[] { "M3 6h18v12H3V6z", "m3 7 9 6 9-6" },
        "place" => new[] { "M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z", "M12 10.5a1.5 1.5 0 1 0 0-.01" },
        "clock" => new[] { "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z", "M12 7v5l3.5 2" },

        // Fallback: a dot, so a name typed wrongly is visible rather than silently missing.
        _ => new[] { "M12 12h.01" }
    };
}
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @foreach (var path in paths)
    {
        <path d="@path" />
    }
</svg>
