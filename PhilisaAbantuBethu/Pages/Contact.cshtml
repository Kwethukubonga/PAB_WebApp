@page
@model ContactModel
@{
    var s = HttpContext.Strings();
    ViewData["Title"] = s.Nav.Contact;
    var sent = bool.TryParse(HttpContext.Request.Query["sent"], out var sentFlag) && sentFlag;

    const string inputCls = "w-full border border-ink-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white text-ink-900 placeholder-ink-500";
    const string inputErrorCls = "w-full border-2 border-red-600 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent bg-white text-ink-900 placeholder-ink-500";
    const string labelCls = "block text-sm font-medium text-ink-700 mb-1.5";
    const string errorTextCls = "mt-1.5 text-sm font-medium text-red-700";

    string? Err(string field) => Model.ErrorFor(field);
    string Cls(string field) => Err(field) is null ? inputCls : inputErrorCls;
    string? Invalid(string field) => Err(field) is null ? null : "true";
    string? Described(string field, string id) => Err(field) is null ? null : id + "-error";

    var subjects = PhilisaAbantuBethu.Forms.ContactValidator.SubjectsFor(s.Lang);
    var sendingLabel = s["RequestSupport.Sending"];

    var messagePlaceholder = s["Contact.WriteMessageHere"];

    var details = new[]
    {
        ("phone", s["Contact.Phone"],            "+27 (0)21 565 0668",            s["Contact.MonFri8am5pm"]),
        ("mail", s["Layout.Email"],          "admin@philisaabafazi.org", s["Contact.ResponseWithin2448"]),
        ("place", s["Contact.Address"],          "55 Strauss Road, Steenberg", s["Contact.7965WesternCapeSouth"]),
        ("emergency_home", s["Contact.CrisisLine"], "+27 (0)81 746 9889",      s["Contact.AvailableAfterHours"])
    };
}

<section class="py-20 bg-brand-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
        <p class="text-on-brand-muted text-sm font-semibold uppercase tracking-widest mb-3">@s["Contact.GetTouch"]</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-5 font-serif">@s["Contact.ContactUs"]</h1>
        <p class="text-on-brand-muted text-lg max-w-xl mx-auto leading-relaxed">
            @s["Contact.WedLoveHearWhether"]
        </p>
    </div>
</section>

<section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-14">

            <!-- Message form -->
            <div class="lg:col-span-3">
                <h2 class="text-2xl font-bold text-ink-900 mb-7 font-serif">@s["Contact.SendUsMessage"]</h2>

                <div data-contact-success hidden="@(!sent)" class="bg-green-50 border border-green-200 rounded-2xl p-10 text-center">
                    <p class="mx-auto mb-4 w-14 h-14 rounded-full bg-status-successSurface text-status-success flex items-center justify-center"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7" /></svg></p>
                    <h3 class="font-bold text-green-800 text-xl mb-2 font-serif">@s["Contact.MessageSent"]</h3>
                    <p class="text-green-700 text-sm">
                        @s["Contact.ThankReachingOutTeam"]
                    </p>
                </div>

                @if (Model.FormError is not null)
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl px-5 py-4 mb-6" role="alert">
                        <p class="text-red-800 text-sm font-semibold">@Model.FormError</p>
                    </div>
                }

                <form method="post" data-contact-form data-busy-form hidden="@sent" class="space-y-5">
                    <!-- Only bots fill this in. People never see it. -->
                    <div class="hp-field" aria-hidden="true">
                        <label for="c-website">Website</label>
                        <input id="c-website" name="Website" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="@labelCls" for="c-name">@s["Contact.FullName"] *</label>
                            <input id="c-name" name="Name" value="@Model.Name" required aria-required="true" type="text" autocomplete="name" maxlength="100"
                                   class="@Cls("Name")" aria-invalid="@Invalid("Name")" aria-describedby="@Described("Name", "c-name")" />
                            @if (Err("Name") is string nameError)
                            {
                                <p id="c-name-error" class="@errorTextCls">@nameError</p>
                            }
                        </div>
                        <div>
                            <label class="@labelCls" for="c-email">@s["Contact.EmailAddress"]</label>
                            <input id="c-email" name="Email" value="@Model.Email" type="email" autocomplete="email" maxlength="254"
                                   class="@Cls("Email")" aria-invalid="@Invalid("Email")" aria-describedby="@Described("Email", "c-email")" />
                            @if (Err("Email") is string emailError)
                            {
                                <p id="c-email-error" class="@errorTextCls">@emailError</p>
                            }
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="@labelCls" for="c-phone">@s["Contact.PhoneNumber"]</label>
                            <input id="c-phone" name="Phone" value="@Model.Phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" placeholder="082 123 4567"
                                   class="@Cls("Phone")" aria-invalid="@Invalid("Phone")" aria-describedby="@Described("Phone", "c-phone")" />
                            @if (Err("Phone") is string phoneError)
                            {
                                <p id="c-phone-error" class="@errorTextCls">@phoneError</p>
                            }
                        </div>
                        <div>
                            <label class="@labelCls" for="c-subject">@s["Contact.Subject"] *</label>
                            <select id="c-subject" name="Subject" required aria-required="true"
                                    class="@Cls("Subject")" aria-invalid="@Invalid("Subject")" aria-describedby="@Described("Subject", "c-subject")">
                                <option value="">@s["Contact.SelectSubject"]</option>
                                @foreach (var subject in subjects)
                                {
                                    <option value="@subject" selected="@(Model.Subject == subject)">@subject</option>
                                }
                            </select>
                            @if (Err("Subject") is string subjectError)
                            {
                                <p id="c-subject-error" class="@errorTextCls">@subjectError</p>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="@labelCls" for="c-message">@s["Contact.Message"] *</label>
                        <textarea id="c-message" name="Message" required aria-required="true" rows="6" maxlength="3000"
                                  placeholder="@messagePlaceholder"
                                  class="@Cls("Message") resize-none" aria-invalid="@Invalid("Message")" aria-describedby="@Described("Message", "c-message")">@Model.Message</textarea>
                        @if (Err("Message") is string messageError)
                        {
                            <p id="c-message-error" class="@errorTextCls">@messageError</p>
                        }
                    </div>

                    <button type="submit" data-busy-label="@sendingLabel"
                            class="bg-brand-700 hover:bg-brand-800 disabled:bg-brand-500 disabled:cursor-wait text-white font-semibold px-8 py-3.5 rounded-full transition-colors inline-flex items-center gap-2">
                        @s["Contact.SendMessage"]
                    </button>
                </form>
            </div>

            <!-- Details -->
            <div class="lg:col-span-2 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-ink-900 mb-6 font-serif">@s["Contact.Details"]</h2>
                    <dl class="space-y-5">
                        @foreach (var (icon, label, value, sub) in details)
                        {
                            <div class="flex items-start gap-4">
                                <span class="text-brand-700 flex-shrink-0 mt-0.5"><partial name="_Icon" model="@icon" /></span>
                                <div>
                                    <dt class="font-semibold text-ink-900 text-sm">@label</dt>
                                    <dd class="text-ink-700 text-sm">@value</dd>
                                    <dd class="text-ink-500 text-xs">@sub</dd>
                                </div>
                            </div>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</section>