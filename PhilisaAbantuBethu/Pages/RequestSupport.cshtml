@page
@model RequestSupportModel
@{
    var s = HttpContext.Strings();
    var f = s.Form;
    ViewData["Title"] = f.Title;

    const string inputCls = "w-full border border-ink-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white text-ink-900 placeholder-ink-500 transition-colors";
    const string inputErrorCls = "w-full border-2 border-red-600 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent bg-white text-ink-900 placeholder-ink-500 transition-colors";
    const string labelCls = "block text-sm font-medium text-ink-700 mb-1.5";
    const string errorTextCls = "mt-1.5 text-sm font-medium text-red-700";
    const string choiceCls = "flex items-center gap-3 border border-ink-200 text-ink-700 hover:border-ink-300 has-[:checked]:border-brand-700 has-[:checked]:bg-brand-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-500 rounded-xl px-4 cursor-pointer transition-all text-sm";

    string? Err(string field) => Model.ErrorFor(field);
    string Cls(string field) => Err(field) is null ? inputCls : inputErrorCls;
    string? Invalid(string field) => Err(field) is null ? null : "true";
    string? Described(string field, string id) => Err(field) is null ? null : id + "-error";

    // After a failed submit, open the first step that has a problem in it.
    var stepFields = new[]
    {
        new[] { "FirstName", "Surname", "Phone", "Email", "Area", "ContactMethod" },
        new[] { "SupportType", "Situation", "Urgent" },
        new[] { "Extra", "Declaration" }
    };
    var startStep = 1;
    for (var i = 0; i < stepFields.Length; i++)
    {
        if (stepFields[i].Any(field => Err(field) != null)) { startStep = i + 1; break; }
    }

    var stepLabels = new[] { f.Step1Label, f.Step2Label, f.Step3Label };

    var progressLabel = s["RequestSupport.FormProgress"];
    var yesLabel = s["RequestSupport.Yes"];
    var noLabel = s["RequestSupport.No"];
    var sendingLabel = s["RequestSupport.Sending"];
    var stepOfLabel = s["RequestSupport.StepOf"];
    // The same line the script writes on every step change, rendered for the first one so a
    // phone shows the step's name before any JavaScript runs (F7).
    var initialStepStatus = stepOfLabel.Replace("{0}", startStep.ToString()).Replace("{1}", stepLabels.Length.ToString())
        + ": " + stepLabels[startStep - 1];

    var contactMethods = new[]
    {
        ("phone",    f.ContactPhone),
        ("whatsapp", f.ContactWhatsApp),
        ("email",    f.ContactEmail),
        ("visit",    f.ContactVisit)
    };
}

<section class="py-14 bg-brand-900 text-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
        @* The "GET HELP" eyebrow above the heading is gone: the heading already says it (E4). *@
        <h1 class="text-3xl md:text-4xl font-bold mb-3 font-serif">@f.Title</h1>
        <p class="text-on-brand-muted text-base max-w-xl mx-auto leading-relaxed">@f.Subtitle</p>
    </div>
</section>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">

    <div class="bg-amber-50 border border-amber-200 rounded-xl px-5 py-4 mb-8 flex gap-3">
        <span class="text-amber-700 flex-shrink-0 mt-0.5">
            <partial name="_Icon" model="@("place")" />
        </span>
        <p class="text-amber-800 text-sm leading-relaxed">@f.ServiceArea</p>
    </div>

    <!-- Progress -->
    <ol class="flex items-center gap-2 mb-8" aria-label="@progressLabel">
        @for (var i = 0; i < stepLabels.Length; i++)
        {
            <li class="flex items-center gap-2 flex-1 last:flex-none">
                <span data-step-marker class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold transition-all bg-ink-200 text-ink-500">@(i + 1)</span>
                <span data-step-label class="text-xs font-medium hidden sm:block flex-shrink-0 text-ink-500">@stepLabels[i]</span>
                @if (i < stepLabels.Length - 1)
                {
                    <span data-step-bar class="flex-1 h-0.5 bg-ink-200"></span>
                }
            </li>
        }
    </ol>

    @if (Model.FormError is not null)
    {
        <div class="bg-red-50 border border-red-200 rounded-xl px-5 py-4 mb-6" role="alert">
            <p class="text-red-800 text-sm font-semibold">@Model.FormError</p>
        </div>
    }

    <form method="post" data-step-form
          data-start-step="@startStep"
          data-yes-label="@yesLabel"
          data-no-label="@noLabel"
          data-step-of-label="@stepOfLabel"
          data-completed-label="@s["RequestSupport.Completed"]">

        @*
            Announces the step when it changes, and on a phone it is the only place the step's
            name appears at all: the labels beside the circles are hidden below sm, so the
            progress row there was three numbered dots with nothing to say what they were (F7).
        *@
        <p data-step-status aria-live="polite"
           class="sm:sr-only mb-6 text-sm font-semibold text-brand-700">@initialStepStatus</p>

        <!-- Only bots fill this in. People never see it. -->
        <div class="hp-field" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="Website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="bg-white rounded-2xl border border-ink-100 shadow-sm p-8">

            <!-- Step 1 — About you -->
            <div data-step="1">
                <h2 tabindex="-1" data-step-heading class="text-xl font-bold text-ink-900 mb-6 focus:outline-none font-serif">@f.Step1Label</h2>
                <div class="space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="@labelCls" for="firstName">@f.FirstName *</label>
                            <input id="firstName" name="FirstName" value="@Model.FirstName" data-required required aria-required="true"
                                   type="text" autocomplete="given-name" maxlength="60" class="@Cls("FirstName")"
                                   aria-invalid="@Invalid("FirstName")" aria-describedby="@Described("FirstName", "firstName")" />
                            @if (Err("FirstName") is string firstNameError)
                            {
                                <p id="firstName-error" class="@errorTextCls">@firstNameError</p>
                            }
                        </div>
                        <div>
                            <label class="@labelCls" for="surname">@f.Surname *</label>
                            <input id="surname" name="Surname" value="@Model.Surname" data-required required aria-required="true"
                                   type="text" autocomplete="family-name" maxlength="60" class="@Cls("Surname")"
                                   aria-invalid="@Invalid("Surname")" aria-describedby="@Described("Surname", "surname")" />
                            @if (Err("Surname") is string surnameError)
                            {
                                <p id="surname-error" class="@errorTextCls">@surnameError</p>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="@labelCls" for="phone">@f.Phone *</label>
                        <input id="phone" name="Phone" value="@Model.Phone" data-required required aria-required="true"
                               type="tel" autocomplete="tel" inputmode="tel" maxlength="20" placeholder="082 123 4567" class="@Cls("Phone")"
                               aria-invalid="@Invalid("Phone")" aria-describedby="@Described("Phone", "phone")" />
                        @if (Err("Phone") is string phoneError)
                        {
                            <p id="phone-error" class="@errorTextCls">@phoneError</p>
                        }
                    </div>
                    <div>
                        <label class="@labelCls" for="email">@f.Email</label>
                        <input id="email" name="Email" value="@Model.Email" type="email" autocomplete="email" maxlength="254" class="@Cls("Email")"
                               aria-invalid="@Invalid("Email")" aria-describedby="@Described("Email", "email")" />
                        @if (Err("Email") is string emailError)
                        {
                            <p id="email-error" class="@errorTextCls">@emailError</p>
                        }
                    </div>
                    <div>
                        <label class="@labelCls" for="area">@f.Area *</label>
                        <input id="area" name="Area" value="@Model.Area" data-required required aria-required="true"
                               type="text" autocomplete="address-level2" maxlength="100" placeholder="@f.AreaPlaceholder" class="@Cls("Area")"
                               aria-invalid="@Invalid("Area")" aria-describedby="@Described("Area", "area")" />
                        @if (Err("Area") is string areaError)
                        {
                            <p id="area-error" class="@errorTextCls">@areaError</p>
                        }
                    </div>

                    <fieldset aria-describedby="@Described("ContactMethod", "contactMethod")">
                        <legend class="@labelCls">@f.ContactMethod</legend>
                        <div class="grid grid-cols-2 gap-3 mt-2">
                            @foreach (var (value, label) in contactMethods)
                            {
                                <label class="@choiceCls py-3">
                                    <input type="radio" name="ContactMethod" value="@value" checked="@(Model.ContactMethod == value)" class="accent-brand-700 flex-shrink-0" />
                                    @label
                                </label>
                            }
                        </div>
                        @if (Err("ContactMethod") is string contactMethodError)
                        {
                            <p id="contactMethod-error" class="@errorTextCls">@contactMethodError</p>
                        }
                    </fieldset>
                </div>
            </div>

            <!-- Step 2 — Support needed -->
            <div data-step="2">
                <h2 tabindex="-1" data-step-heading class="text-xl font-bold text-ink-900 mb-6 focus:outline-none font-serif">@f.Step2Label</h2>
                <div class="space-y-5">
                    <div>
                        <label class="@labelCls" for="supportType">@f.SupportType *</label>
                        <select id="supportType" name="SupportType" data-required required aria-required="true" class="@Cls("SupportType")"
                                aria-invalid="@Invalid("SupportType")" aria-describedby="@Described("SupportType", "supportType")">
                            <option value="">@f.SupportTypePlaceholder</option>
                            @foreach (var type in s.SupportTypes)
                            {
                                <option value="@type" selected="@(Model.SupportType == type)">@type</option>
                            }
                        </select>
                        @if (Err("SupportType") is string supportTypeError)
                        {
                            <p id="supportType-error" class="@errorTextCls">@supportTypeError</p>
                        }
                    </div>

                    <div>
                        <label class="@labelCls" for="situation">@f.Situation *</label>
                        <textarea id="situation" name="Situation" data-required required aria-required="true" rows="7" maxlength="3000"
                                  placeholder="@f.SituationPlaceholder"
                                  class="@Cls("Situation") resize-none"
                                  aria-invalid="@Invalid("Situation")" aria-describedby="@Described("Situation", "situation")">@Model.Situation</textarea>
                        @if (Err("Situation") is string situationError)
                        {
                            <p id="situation-error" class="@errorTextCls">@situationError</p>
                        }
                    </div>

                    <fieldset aria-describedby="@Described("Urgent", "urgent")">
                        <legend class="@labelCls">@f.Urgent</legend>
                        <div class="space-y-2.5 mt-2">
                            <label class="@choiceCls py-3.5">
                                <input type="radio" name="Urgent" value="yes" checked="@(Model.Urgent == "yes")" class="accent-brand-700 flex-shrink-0" />
                                @f.UrgentYes
                            </label>
                            <label class="@choiceCls py-3.5">
                                <input type="radio" name="Urgent" value="no" checked="@(Model.Urgent != "yes")" class="accent-brand-700 flex-shrink-0" />
                                @f.UrgentNo
                            </label>
                        </div>
                        @if (Err("Urgent") is string urgentError)
                        {
                            <p id="urgent-error" class="@errorTextCls">@urgentError</p>
                        }
                    </fieldset>

                    <p class="text-xs text-ink-600 leading-relaxed bg-ink-50 border border-ink-100 rounded-xl px-4 py-3">
                        @s["RequestSupport.IfImmediateDangerCall"]
                        <a href="tel:+27817469889" class="text-brand-700 font-semibold">+27 (0)81 746 9889</a>
                    </p>
                </div>
            </div>

            <!-- Step 3 — Confirm and submit -->
            <div data-step="3">
                <h2 tabindex="-1" data-step-heading class="text-xl font-bold text-ink-900 mb-6 focus:outline-none font-serif">@f.Step3Label</h2>
                <div class="space-y-6">
                    <div>
                        <label class="@labelCls" for="extra">@f.ExtraInfo</label>
                        <textarea id="extra" name="Extra" rows="4" maxlength="2000"
                                  placeholder="@f.ExtraInfoPlaceholder"
                                  class="@Cls("Extra") resize-none"
                                  aria-invalid="@Invalid("Extra")" aria-describedby="@Described("Extra", "extra")">@Model.Extra</textarea>
                        @if (Err("Extra") is string extraError)
                        {
                            <p id="extra-error" class="@errorTextCls">@extraError</p>
                        }
                    </div>

                    <div class="bg-ink-50 border border-ink-100 rounded-xl p-5">
                        <h3 class="text-sm font-semibold text-ink-700 mb-3">@s["RequestSupport.RequestSummary"]</h3>
                        <dl class="space-y-2 text-sm">
                            <div class="flex gap-3">
                                <dt class="text-ink-600 w-28 flex-shrink-0">@s["RequestSupport.Name"]:</dt>
                                <dd class="text-ink-900 font-medium" data-summary-for="FullName">-</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-ink-600 w-28 flex-shrink-0">@f.Phone:</dt>
                                <dd class="text-ink-900 font-medium" data-summary-for="Phone">-</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-ink-600 w-28 flex-shrink-0">@s["RequestSupport.Area"]:</dt>
                                <dd class="text-ink-900 font-medium" data-summary-for="Area">-</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-ink-600 w-28 flex-shrink-0">@s["RequestSupport.SupportType"]:</dt>
                                <dd class="text-ink-900 font-medium" data-summary-for="SupportType">-</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-ink-600 w-28 flex-shrink-0">@s["RequestSupport.Urgent"]:</dt>
                                <dd class="text-ink-900 font-medium" data-summary-for="Urgent">-</dd>
                            </div>
                        </dl>
                    </div>

                    <div>
                        <div class="flex items-start gap-3">
                            <input id="declaration" name="Declaration" value="true" data-required required aria-required="true" type="checkbox"
                                   checked="@Model.Declaration"
                                   aria-invalid="@Invalid("Declaration")" aria-describedby="@Described("Declaration", "declaration")"
                                   class="mt-1 w-4 h-4 rounded accent-brand-700 flex-shrink-0" />
                            <label for="declaration" class="text-sm text-ink-600 leading-relaxed cursor-pointer">@f.Declaration *</label>
                        </div>
                        @if (Err("Declaration") is string declarationError)
                        {
                            <p id="declaration-error" class="@errorTextCls">@declarationError</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex items-center justify-between mt-6">
            <button type="button" data-step-back disabled class="flex items-center gap-2 text-sm font-medium transition-colors text-ink-300 cursor-not-allowed">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                @f.Back
            </button>

            <button type="button" data-step-next class="bg-brand-700 hover:bg-brand-800 text-white font-semibold px-8 py-3 rounded-full transition-colors flex items-center gap-2 text-sm">
                @f.Next
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <button type="submit" data-step-submit data-busy-label="@sendingLabel"
                    class="bg-brand-700 hover:bg-brand-800 disabled:bg-brand-500 disabled:cursor-wait text-white font-bold px-8 py-3 rounded-full transition-colors text-sm inline-flex items-center gap-2">
                @f.SubmitRequest
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/request-support-wizard.js" asp-append-version="true"></script>
}
