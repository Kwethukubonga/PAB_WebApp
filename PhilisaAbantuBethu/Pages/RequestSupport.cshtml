@page
@model RequestSupportModel
@{
    var s = HttpContext.Strings();
    var f = s.Form;
    ViewData["Title"] = f.Title;

    const string inputCls = "w-full border border-stone-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-white text-stone-900 placeholder-stone-400 transition-colors";
    const string labelCls = "block text-sm font-medium text-stone-700 mb-1.5";

    var stepLabels = new[] { f.Step1Label, f.Step2Label, f.Step3Label };

    var progressLabel = s.Pick("Form progress", "Inkqubela yefomu", "Vorm vordering");
    var yesLabel = s.Pick("Yes", "Ewe", "Ja");
    var noLabel = s.Pick("No", "Hayi", "Nee");

    var contactMethods = new[]
    {
        ("phone",    f.ContactPhone),
        ("whatsapp", f.ContactWhatsApp),
        ("email",    f.ContactEmail),
        ("visit",    f.ContactVisit)
    };
}

<section class="py-14 bg-purple-900 text-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
        <p class="text-purple-300 text-sm font-semibold uppercase tracking-widest mb-3">@s.Pick("Get Help", "Fumana Uncedo", "Kry Hulp")</p>
        <h1 class="text-3xl md:text-4xl font-bold mb-3" style="font-family: Lora, serif;">@f.Title</h1>
        <p class="text-purple-100 text-base max-w-xl mx-auto leading-relaxed">@f.Subtitle</p>
    </div>
</section>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">

    <div class="bg-amber-50 border border-amber-200 rounded-xl px-5 py-4 mb-8 flex gap-3">
        <span class="text-amber-600 text-lg flex-shrink-0 mt-0.5" aria-hidden="true">📍</span>
        <p class="text-amber-800 text-sm leading-relaxed">@f.ServiceArea</p>
    </div>

    <!-- Progress -->
    <ol class="flex items-center gap-2 mb-8" aria-label="@progressLabel">
        @for (var i = 0; i < stepLabels.Length; i++)
        {
            <li class="flex items-center gap-2 flex-1 last:flex-none">
                <span data-step-marker class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold transition-all bg-stone-200 text-stone-500">@(i + 1)</span>
                <span data-step-label class="text-xs font-medium hidden sm:block flex-shrink-0 text-stone-400">@stepLabels[i]</span>
                @if (i < stepLabels.Length - 1)
                {
                    <span data-step-bar class="flex-1 h-0.5 bg-stone-200"></span>
                }
            </li>
        }
    </ol>

    <form method="post" data-step-form
          data-yes-label="@yesLabel"
          data-no-label="@noLabel">
        <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-8">

            <!-- Step 1 — About you -->
            <div data-step="1">
                <h2 class="text-xl font-bold text-stone-900 mb-6" style="font-family: Lora, serif;">@f.Step1Label</h2>
                <div class="space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="@labelCls" for="firstName">@f.FirstName *</label>
                            <input id="firstName" name="FirstName" data-required type="text" placeholder="Nomsa" class="@inputCls" />
                        </div>
                        <div>
                            <label class="@labelCls" for="surname">@f.Surname *</label>
                            <input id="surname" name="Surname" data-required type="text" placeholder="Dlamini" class="@inputCls" />
                        </div>
                    </div>
                    <div>
                        <label class="@labelCls" for="phone">@f.Phone *</label>
                        <input id="phone" name="Phone" data-required type="tel" placeholder="071 000 0000" class="@inputCls" />
                    </div>
                    <div>
                        <label class="@labelCls" for="email">@f.Email</label>
                        <input id="email" name="Email" type="email" placeholder="nomsa@@email.com" class="@inputCls" />
                    </div>
                    <div>
                        <label class="@labelCls" for="area">@f.Area *</label>
                        <input id="area" name="Area" data-required type="text" placeholder="@f.AreaPlaceholder" class="@inputCls" />
                    </div>

                    <fieldset>
                        <legend class="@labelCls">@f.ContactMethod</legend>
                        <div class="grid grid-cols-2 gap-3 mt-2">
                            @foreach (var (value, label) in contactMethods)
                            {
                                <label class="flex items-center gap-3 border border-stone-200 text-stone-700 hover:border-stone-300 rounded-xl px-4 py-3 cursor-pointer transition-all text-sm">
                                    <input type="radio" name="ContactMethod" value="@value" checked="@(value == "phone" ? "checked" : null)" class="accent-purple-700 flex-shrink-0" />
                                    @label
                                </label>
                            }
                        </div>
                    </fieldset>
                </div>
            </div>

            <!-- Step 2 — Support needed -->
            <div data-step="2">
                <h2 class="text-xl font-bold text-stone-900 mb-6" style="font-family: Lora, serif;">@f.Step2Label</h2>
                <div class="space-y-5">
                    <div>
                        <label class="@labelCls" for="supportType">@f.SupportType *</label>
                        <select id="supportType" name="SupportType" data-required class="@inputCls">
                            <option value="">@f.SupportTypePlaceholder</option>
                            @foreach (var type in s.SupportTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="@labelCls" for="situation">@f.Situation *</label>
                        <textarea id="situation" name="Situation" data-required rows="7"
                                  placeholder="@f.SituationPlaceholder"
                                  class="@inputCls resize-none"></textarea>
                    </div>

                    <fieldset>
                        <legend class="@labelCls">@f.Urgent</legend>
                        <div class="space-y-2.5 mt-2">
                            <label class="flex items-center gap-3 border border-stone-200 text-stone-700 hover:border-stone-300 rounded-xl px-4 py-3.5 cursor-pointer transition-all text-sm">
                                <input type="radio" name="Urgent" value="yes" class="accent-purple-700 flex-shrink-0" />
                                @f.UrgentYes
                            </label>
                            <label class="flex items-center gap-3 border border-stone-200 text-stone-700 hover:border-stone-300 rounded-xl px-4 py-3.5 cursor-pointer transition-all text-sm">
                                <input type="radio" name="Urgent" value="no" checked class="accent-purple-700 flex-shrink-0" />
                                @f.UrgentNo
                            </label>
                        </div>
                    </fieldset>

                    <p class="text-xs text-stone-500 leading-relaxed bg-stone-50 border border-stone-100 rounded-xl px-4 py-3">
                        @s.Pick("If you are in immediate danger, call 10111 or our 24-hour crisis line on",
                                "Ukuba usengozini ngoku, fowunela u-10111 okanye umgca wethu wongxamiseko wee-24 iiyure ku-",
                                "As jy in onmiddellike gevaar is, skakel 10111 of ons 24-uur-krisislyn by")
                        <a href="tel:+27210000001" class="text-purple-700 font-semibold">+27 21 000 0001</a>
                    </p>
                </div>
            </div>

            <!-- Step 3 — Confirm and submit -->
            <div data-step="3">
                <h2 class="text-xl font-bold text-stone-900 mb-6" style="font-family: Lora, serif;">@f.Step3Label</h2>
                <div class="space-y-6">
                    <div>
                        <label class="@labelCls" for="extra">@f.ExtraInfo</label>
                        <textarea id="extra" name="Extra" rows="4"
                                  placeholder="@f.ExtraInfoPlaceholder"
                                  class="@inputCls resize-none"></textarea>
                    </div>

                    <div class="bg-stone-50 border border-stone-100 rounded-xl p-5">
                        <h3 class="text-sm font-semibold text-stone-700 mb-3">@s.Pick("Request Summary", "Isishwankathelo Sesicelo", "Versoekopsomming")</h3>
                        <dl class="space-y-2 text-sm">
                            <div class="flex gap-3">
                                <dt class="text-stone-400 w-28 flex-shrink-0">@s.Pick("Name", "Igama", "Naam"):</dt>
                                <dd class="text-stone-800 font-medium" data-summary-for="FullName">—</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-stone-400 w-28 flex-shrink-0">@f.Phone:</dt>
                                <dd class="text-stone-800 font-medium" data-summary-for="Phone">—</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-stone-400 w-28 flex-shrink-0">@s.Pick("Area", "Indawo", "Area"):</dt>
                                <dd class="text-stone-800 font-medium" data-summary-for="Area">—</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-stone-400 w-28 flex-shrink-0">@s.Pick("Support type", "Uhlobo", "Tipe ondersteuning"):</dt>
                                <dd class="text-stone-800 font-medium" data-summary-for="SupportType">—</dd>
                            </div>
                            <div class="flex gap-3">
                                <dt class="text-stone-400 w-28 flex-shrink-0">@s.Pick("Urgent", "Ngxama", "Dringend"):</dt>
                                <dd class="text-stone-800 font-medium" data-summary-for="Urgent">—</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="flex items-start gap-3">
                        <input id="declaration" name="Declaration" value="true" data-required type="checkbox"
                               class="mt-1 w-4 h-4 rounded accent-purple-700 flex-shrink-0" />
                        <label for="declaration" class="text-sm text-stone-600 leading-relaxed cursor-pointer">@f.Declaration *</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex items-center justify-between mt-6">
            <button type="button" data-step-back disabled class="flex items-center gap-2 text-sm font-medium transition-colors text-stone-300 cursor-not-allowed">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                @f.Back
            </button>

            <button type="button" data-step-next class="bg-purple-700 hover:bg-purple-800 text-white font-semibold px-8 py-3 rounded-full transition-colors flex items-center gap-2 text-sm">
                @f.Next
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <button type="submit" data-step-submit class="bg-purple-700 hover:bg-purple-800 text-white font-bold px-8 py-3 rounded-full transition-colors text-sm">
                @f.SubmitRequest
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/request-support-wizard.js" asp-append-version="true"></script>
}
