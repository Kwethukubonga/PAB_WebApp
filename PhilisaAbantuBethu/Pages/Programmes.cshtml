@page
@{
    var s = HttpContext.Strings();
    ViewData["Title"] = s.Nav.Programmes;
}

<section class="py-20 bg-brand-900 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-15">
        <partial name="_Image" model='new SitePhoto( Src: "/img/programmes/after-school/hero.jpg", Class: "w-full h-full object-cover", Sizes: "100vw", Eager: true, Decorative: true)' />
    </div>
    <div class="relative z-10 max-w-3xl mx-auto px-4">
        <p class="text-on-brand-muted text-sm font-semibold uppercase tracking-widest mb-3">@s["Home.WhatWeDo"]</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-5 font-serif">@s.Nav.Programmes</h1>
        <p class="text-on-brand-muted text-lg leading-relaxed max-w-xl mx-auto">
            @s["Programmes.TenProgrammesOneMission"]
        </p>
    </div>
</section>

<section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var prog in SiteData.Programmes)
            {
                <a href="/Programmes/@prog.Id"
                   class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 group border border-ink-100 flex flex-col">
                    <div class="h-52 overflow-hidden bg-ink-200 relative">
                        <partial name="_Image" model='new SitePhoto( Src: prog.ImagePath, Alt: prog.TitleFor(s), Class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", Sizes: "(min-width: 1024px) 33vw, 100vw")' />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <p class="text-[11px] font-bold uppercase tracking-widest mb-2" style="color: @prog.Accent;">@prog.TaglineFor(s)</p>
                        <h2 class="font-bold text-ink-900 text-xl mb-3 leading-snug font-serif">@prog.TitleFor(s)</h2>
                        <p class="text-ink-500 text-sm leading-relaxed mb-6 flex-1">@prog.DescriptionFor(s)</p>
                        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 group-hover:text-brand-900 transition-colors mt-auto">
                            @s["Programmes.LearnMore"]
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="group-hover:translate-x-1 transition-transform" aria-hidden="true">
                                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="py-16 bg-amber-50 border-t border-amber-100 text-center">
    <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-ink-900 mb-4 font-serif">@s["Programmes.NeedSupport"]</h2>
        <p class="text-ink-600 mb-6 text-sm">
            @s["Programmes.GetTouchTeamWill"]
        </p>
        <a href="/Contact" class="inline-block bg-brand-700 hover:bg-brand-800 text-white font-semibold px-8 py-3.5 rounded-full transition-colors">
            @s.Home.ContactUs
        </a>
    </div>
</section>