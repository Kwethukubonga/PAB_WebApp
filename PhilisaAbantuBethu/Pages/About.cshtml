        ("Nthombizokwanda Sihulu", "Social Auxiliary Worker",  "/img/team/nthombizokwanda-sihulu.jpg"),
        ("Francina Esbach",        "House Mother",              "/img/team/francina-esbach.jpg"),
        ("Stacey Samuels",         "House Mother",              "/img/team/stacey-samuels.jpg"),
        ("Lindsay Adams",          "House Mother",              "/img/team/lindsay-adams.jpg"),
        ("Olivia Maart",           "House Mother",              "/img/team/olivia-maart.jpg"),
        ("Sylvia Kruger",          "House Mother",              "/img/team/sylvia-kruger.jpg"),
        ("Nthombikayise Ndwandwa", "House Mother",              "/img/team/nthombikayise-ndwandwa.jpg"),
        ("Brandon Samuels",        "Youth Facilitator",        "/img/team/brandon-samuels.jpg"),
        ("Yvonne Botha",           "House Mother",              "/img/team/yvonne-botha.jpg"),
        ("Rihanna Galant",         "House Mother",              "/img/team/rihanna-galant.jpg"),
        ("Alinafe Kamtolo",        "Cleaner",                    "/img/team/alinafe-kamtolo.jpg"),
        ("Melissa Rudolph",        "Psychologist",              "/img/team/melissa-rudolph.jpg"),
        ("Roelien Pimentel",       "Cook",                       "/img/team/roelien-pimentel.jpg"),
        ("Lena Rayepen",           "Sewing Facilitator",        "/img/team/lena-rayepen.jpg")
    };

    var historyImages = new[]
    {
        "/img/about/history-1.jpg",
        "/img/about/history-2.jpg",
        "/img/about/history-3.jpg",
        "/img/about/history-4.jpg"
    };
}

<!-- Page hero -->
<section class="relative py-24 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
        <partial name="_Image" model='new SitePhoto( Src: "/img/programmes/senior-programme/hero.jpg", Class: "w-full h-full object-cover", Sizes: "100vw", Eager: true, Decorative: true)' />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
        <p class="text-on-brand-muted text-sm font-semibold uppercase tracking-widest mb-3">@s["About.Story"]</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-5 font-serif">@s["Layout.AboutUs"]</h1>
        <p class="text-on-brand-muted text-lg max-w-2xl mx-auto leading-relaxed">
            @s["About.LearnWhoWhatDrives"]
        </p>
    </div>
</section>

<!-- History -->
<section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div>
                <p class="text-amber-700 text-sm font-semibold uppercase tracking-widest mb-3">@s["About.History"]</p>
                <h2 class="text-3xl md:text-4xl font-bold text-ink-900 mb-6 leading-snug font-serif">
                    @s["About.15YearsBuildingCommunity"]
                </h2>
                <div class="space-y-4 text-ink-600 leading-relaxed">
                    <p>
                        @s["About.PhilisaAbafaziBethuMeaning"]
                    </p>
                    <p>
                        @s["About.OverYearsExpandedReach"]
                    </p>
                    <p>
                        @s["About.TodayServeOver14"]
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @foreach (var img in historyImages)
                {
                    <div class="rounded-xl overflow-hidden bg-ink-200 aspect-[4/3]">
                        <partial name="_Image" model='new SitePhoto( Src: img, Class: "w-full h-full object-cover", Sizes: "(min-width: 768px) 25vw, 50vw", Decorative: true)' />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Mission & vision -->
<section class="py-20 bg-ink-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-brand-900 text-white rounded-2xl p-10">
                <p class="text-on-brand-muted text-xs font-semibold uppercase tracking-widest mb-4">@s["About.Mission"]</p>
                <h2 class="text-2xl font-bold mb-4 leading-snug font-serif">
                    @s["About.WalkAlongsideCommunitiesTheir"]
                </h2>
                <p class="text-on-brand-muted leading-relaxed">
                    @s["About.CommittedProvidingAccessibleDignified"]
                </p>
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-10">
                <p class="text-amber-700 text-xs font-semibold uppercase tracking-widest mb-4">@s["About.Vision"]</p>
                <h2 class="text-2xl font-bold text-ink-900 mb-4 leading-snug font-serif">
                    @s["About.CommunitiesWhereEveryPerson"]
                </h2>
                <p class="text-ink-600 leading-relaxed">
                    @s["About.EnvisionSouthAfricaWhere"]
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Core values -->
<section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <p class="text-amber-700 text-sm font-semibold uppercase tracking-widest mb-3">@s["About.WhatStand"]</p>
            <h2 class="text-3xl md:text-4xl font-bold text-ink-900 font-serif">@s["About.CoreValues"]</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var (title, icon, desc) in values)
            {
                <div class="bg-white rounded-2xl p-7 border border-ink-100 shadow-sm hover:shadow-md transition-shadow">
                    <p class="text-brand-700 mb-4"><partial name="_Icon" model="@icon" /></p>
                    <h3 class="font-bold text-ink-900 text-lg mb-2 font-serif">@title</h3>
                    <p class="text-ink-500 text-sm leading-relaxed">@desc</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Founder's journey -->
<section class="py-20 bg-brand-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div class="rounded-2xl overflow-hidden aspect-[4/5] max-w-sm mx-auto md:mx-0 shadow-lg">
                <partial name="_Image" model='new SitePhoto( Src: "/img/team/lucinda-evans.jpg", Alt: "Lucinda Evans", Class: "w-full h-full object-cover", Sizes: "(min-width: 768px) 40vw, 100vw")' />
            </div>
            <div>
                <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-3">@s["About.Founder"]</p>
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-snug font-serif">
                    @s["About.Journey"]
                </h2>
                <div class="space-y-4 text-on-brand-muted leading-relaxed">
                    <p>
                        @s["About.LucindaEvansDreamProtecting"]
                    </p>
                    <p>
                        @s["About.SinceThenLucindaHas"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team -->
<section class="py-20 bg-ink-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <p class="text-amber-700 text-sm font-semibold uppercase tracking-widest mb-3">@s["About.Leadership"]</p>
            <h2 class="text-3xl md:text-4xl font-bold text-ink-900 font-serif">@s["About.MeetTeam"]</h2>
            <p class="text-ink-500 mt-3">@s["About.DedicatedPeopleWhoMake"]</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @foreach (var (name, role, image) in team)
            {
                <div class="text-center group">
                    <div class="w-full aspect-square rounded-2xl overflow-hidden bg-ink-200 mb-4 shadow-sm group-hover:shadow-md transition-shadow">
                        <partial name="_Image" model='new SitePhoto( Src: image, Alt: name, Class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", Sizes: "(min-width: 1024px) 20vw, 45vw")' />
                    </div>
                    <h3 class="font-bold text-ink-900 font-serif">@name</h3>
                    <p class="text-ink-500 text-sm mt-1">@role</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-16 bg-brand-900 text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-3xl font-bold mb-4 font-serif">@s["About.ReadyMakeDifference"]</h2>
        <p class="text-on-brand-muted mb-8">@s["About.ExploreProgrammesReachOut"]</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/Programmes" class="bg-amber-500 hover:bg-amber-400 text-ink-900 font-semibold px-8 py-3 rounded-full transition-colors">@s.Home.ExplorePrograms</a>
            <a href="/Contact" class="border border-brand-500 text-white hover:bg-brand-800 font-semibold px-8 py-3 rounded-full transition-colors">@s.Home.ContactUs</a>
        </div>
    </div>
</section>
