@page
@{
    var s = HttpContext.Strings();
    ViewData["Title"] = s["About.AboutUs"];

    var historyImages = new[]
    {
        "/img/about/history-1.jpg",
        "/img/about/history-2.jpg",
        "/img/about/history-3.jpg",
        "/img/about/history-4.jpg"
    };
}

<!-- Page hero -->
<section class="relative py-24 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
        <partial name="_Image" model='new SitePhoto( Src: "/img/programmes/senior-programme/hero.jpg", Class: "w-full h-full object-cover", Sizes: "100vw", Eager: true, Decorative: true)' />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
        <p class="text-on-brand-muted text-sm font-semibold uppercase tracking-widest mb-3">@s["About.Story"]</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-5 font-serif">@s["Layout.AboutUs"]</h1>
        <p class="text-on-brand-muted text-lg max-w-2xl mx-auto leading-relaxed">
            @s["About.LearnWhoWhatDrives"]
        </p>
    </div>
</section>

<!-- History -->
<section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div>
                <p class="text-amber-700 text-sm font-semibold uppercase tracking-widest mb-3">@s["About.History"]</p>
                <h2 class="text-3xl md:text-4xl font-bold text-ink-900 mb-6 leading-snug font-serif">
                    @s["About.15YearsBuildingCommunity"]
                </h2>
                <div class="space-y-4 text-ink-600 leading-relaxed">
                    <p>
                        @s["About.PhilisaAbafaziBethuMeaning"]
                    </p>
                    <p>
                        @s["About.OverYearsExpandedReach"]
                    </p>
                    <p>
                        @s["About.TodayServeOver14"]
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @foreach (var img in historyImages)
                {
                    <div class="rounded-xl overflow-hidden bg-ink-200 aspect-[4/3]">
                        <partial name="_Image" model='new SitePhoto( Src: img, Class: "w-full h-full object-cover", Sizes: "(min-width: 768px) 25vw, 50vw", Decorative: true)' />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Mission & vision -->
<section class="py-20 bg-ink-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-brand-900 text-white rounded-2xl p-10">
                <p class="text-on-brand-muted text-xs font-semibold uppercase tracking-widest mb-4">@s["About.Mission"]</p>
                <h2 class="text-2xl font-bold mb-4 leading-snug font-serif">
                    @s["About.WalkAlongsideCommunitiesTheir"]
                </h2>
                <p class="text-on-brand-muted leading-relaxed">
                    @s["About.CommittedProvidingAccessibleDignified"]
                </p>
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-10">
                <p class="text-amber-700 text-xs font-semibold uppercase tracking-widest mb-4">@s["About.Vision"]</p>
                <h2 class="text-2xl font-bold text-ink-900 mb-4 leading-snug font-serif">
                    @s["About.CommunitiesWhereEveryPerson"]
                </h2>
                <p class="text-ink-600 leading-relaxed">
                    @s["About.EnvisionSouthAfricaWhere"]
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-16 bg-brand-900 text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-3xl font-bold mb-4 font-serif">@s["About.ReadyMakeDifference"]</h2>
        <p class="text-on-brand-muted mb-8">@s["About.ReachOutSupportOrJoin"]</p>
        <div class="flex justify-center">
            <a href="/Contact" class="bg-amber-500 hover:bg-amber-400 text-ink-900 font-semibold px-8 py-3 rounded-full transition-colors">@s.Home.ContactUs</a>
        </div>
    </div>
</section>
