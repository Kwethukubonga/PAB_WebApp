{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:5277/",
        "http://127.0.0.1:5277/About",
        "http://127.0.0.1:5277/Programmes",
        "http://127.0.0.1:5277/Resources",
        "http://127.0.0.1:5277/RequestSupport",
        "http://127.0.0.1:5277/Contact",
        "http://127.0.0.1:5277/Privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
